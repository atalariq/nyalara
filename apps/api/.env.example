# Absolute path to a local Firebase Admin service account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Optional explicit project hint for local tooling.
GOOGLE_CLOUD_PROJECT=your-project-id

# Gemini API key used by POST /v1/generate-energy-insight.
GEMINI_API_KEY=your-gemini-api-key

# Optional Gemini model override for energy insight generation.
GEMINI_MODEL=gemini-3.5-flash
